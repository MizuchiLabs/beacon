{
	"components": {
		"schemas": {
			"ConfigBody": {
				"additionalProperties": false,
				"properties": {
					"chart_type": {
						"description": "Chart rendering style",
						"enum": ["area", "bars"],
						"type": "string"
					},
					"description": { "description": "Dashboard description", "type": "string" },
					"incidents_enabled": {
						"description": "Whether incident tracking is enabled",
						"type": "boolean"
					},
					"timezone": {
						"description": "IANA timezone for displaying timestamps",
						"type": "string"
					},
					"title": { "description": "Dashboard title", "type": "string" }
				},
				"required": ["title", "description", "timezone", "chart_type", "incidents_enabled"],
				"type": "object"
			},
			"DataPoint": {
				"additionalProperties": false,
				"properties": {
					"degraded_ratio": { "format": "double", "type": "number" },
					"down_ratio": { "format": "double", "type": "number" },
					"is_up": { "type": "boolean" },
					"response_time": { "format": "int64", "type": "integer" },
					"timestamp": { "format": "date-time", "type": "string" },
					"up_ratio": { "format": "double", "type": "number" }
				},
				"required": ["timestamp", "response_time", "is_up"],
				"type": "object"
			},
			"ErrorDetail": {
				"additionalProperties": false,
				"properties": {
					"location": {
						"description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
						"type": "string"
					},
					"message": { "description": "Error message text", "type": "string" },
					"value": { "description": "The value at the given location" }
				},
				"type": "object"
			},
			"ErrorModel": {
				"additionalProperties": false,
				"properties": {
					"detail": {
						"description": "A human-readable explanation specific to this occurrence of the problem.",
						"examples": ["Property foo is required but is missing."],
						"type": "string"
					},
					"errors": {
						"description": "Optional list of individual error details",
						"items": { "$ref": "#/components/schemas/ErrorDetail" },
						"type": ["array", "null"]
					},
					"instance": {
						"description": "A URI reference that identifies the specific occurrence of the problem.",
						"examples": ["https://example.com/error-log/abc123"],
						"format": "uri",
						"type": "string"
					},
					"status": {
						"description": "HTTP status code",
						"examples": [400],
						"format": "int64",
						"type": "integer"
					},
					"title": {
						"description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
						"examples": ["Bad Request"],
						"type": "string"
					},
					"type": {
						"default": "about:blank",
						"description": "A URI reference to human-readable documentation for the error.",
						"examples": ["https://example.com/errors/example"],
						"format": "uri",
						"type": "string"
					}
				},
				"type": "object"
			},
			"Incident": {
				"additionalProperties": false,
				"properties": {
					"affected_monitors": { "items": { "type": "string" }, "type": ["array", "null"] },
					"description": { "type": "string" },
					"id": { "type": "string" },
					"resolved_at": { "format": "date-time", "type": "string" },
					"severity": { "type": "string" },
					"started_at": { "format": "date-time", "type": "string" },
					"status": { "type": "string" },
					"title": { "type": "string" },
					"updates": {
						"items": { "$ref": "#/components/schemas/IncidentUpdate" },
						"type": ["array", "null"]
					}
				},
				"required": ["started_at"],
				"type": "object"
			},
			"IncidentUpdate": {
				"additionalProperties": false,
				"properties": {
					"created_at": { "format": "date-time", "type": "string" },
					"message": { "type": "string" },
					"status": { "type": "string" }
				},
				"required": ["message", "status", "created_at"],
				"type": "object"
			},
			"MonitorStats": {
				"additionalProperties": false,
				"properties": {
					"avg_response_time": { "format": "int64", "type": "integer" },
					"check_interval": { "format": "int64", "type": "integer" },
					"data_points": {
						"items": { "$ref": "#/components/schemas/DataPoint" },
						"type": ["array", "null"]
					},
					"id": { "format": "int64", "type": "integer" },
					"name": { "type": "string" },
					"percentiles": { "$ref": "#/components/schemas/Percentiles" },
					"uptime_pct": { "format": "double", "type": "number" },
					"url": { "type": "string" }
				},
				"required": [
					"id",
					"name",
					"url",
					"check_interval",
					"avg_response_time",
					"uptime_pct",
					"percentiles",
					"data_points"
				],
				"type": "object"
			},
			"Percentiles": {
				"additionalProperties": false,
				"properties": {
					"p50": { "format": "int64", "type": "integer" },
					"p75": { "format": "int64", "type": "integer" },
					"p90": { "format": "int64", "type": "integer" },
					"p95": { "format": "int64", "type": "integer" },
					"p99": { "format": "int64", "type": "integer" }
				},
				"required": ["p50", "p75", "p90", "p95", "p99"],
				"type": "object"
			},
			"PushSubscriptionKeys": {
				"additionalProperties": false,
				"properties": {
					"auth": { "description": "Authentication secret", "type": "string" },
					"p256dh": { "description": "Client public key", "type": "string" }
				},
				"required": ["p256dh", "auth"],
				"type": "object"
			},
			"PushSubscriptionRequest": {
				"additionalProperties": false,
				"properties": {
					"endpoint": {
						"description": "Push service endpoint URL",
						"format": "uri",
						"type": "string"
					},
					"keys": { "$ref": "#/components/schemas/PushSubscriptionKeys" }
				},
				"required": ["endpoint", "keys"],
				"type": "object"
			},
			"SubscribeOutputBody": {
				"additionalProperties": false,
				"properties": { "message": { "type": "string" } },
				"required": ["message"],
				"type": "object"
			},
			"UnsubscribeInputBody": {
				"additionalProperties": false,
				"properties": {
					"endpoint": {
						"description": "Push service endpoint URL to remove",
						"format": "uri",
						"type": "string"
					}
				},
				"required": ["endpoint"],
				"type": "object"
			},
			"UnsubscribeOutputBody": {
				"additionalProperties": false,
				"properties": { "message": { "type": "string" } },
				"required": ["message"],
				"type": "object"
			},
			"VAPIDOutputBody": {
				"additionalProperties": false,
				"properties": {
					"publicKey": {
						"description": "VAPID public key for push subscriptions",
						"type": "string"
					}
				},
				"required": ["publicKey"],
				"type": "object"
			}
		}
	},
	"info": { "title": "Beacon API", "version": "1.0.0" },
	"openapi": "3.1.0",
	"paths": {
		"/api/config": {
			"get": {
				"description": "Public configuration used by the dashboard frontend.",
				"operationId": "get-config",
				"responses": {
					"200": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/ConfigBody" } }
						},
						"description": "OK"
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Get dashboard config",
				"tags": ["Config"]
			}
		},
		"/api/incidents": {
			"get": {
				"operationId": "get-incidents",
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"items": { "$ref": "#/components/schemas/Incident" },
									"type": ["array", "null"]
								}
							}
						},
						"description": "OK"
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "List incidents",
				"tags": ["Incidents"]
			}
		},
		"/api/incidents/{id}": {
			"get": {
				"operationId": "get-incident",
				"parameters": [
					{
						"description": "Incident ID",
						"in": "path",
						"name": "id",
						"required": true,
						"schema": { "description": "Incident ID", "type": "string" }
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/Incident" } }
						},
						"description": "OK"
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Get an incident",
				"tags": ["Incidents"]
			}
		},
		"/api/monitors": {
			"get": {
				"description": "Aggregated uptime and response time stats per monitor over the requested window.",
				"operationId": "get-monitors",
				"parameters": [
					{
						"description": "How far back to aggregate, in seconds",
						"explode": false,
						"in": "query",
						"name": "seconds",
						"schema": {
							"default": 86400,
							"description": "How far back to aggregate, in seconds",
							"format": "int64",
							"maximum": 31536000,
							"minimum": 60,
							"type": "integer"
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"items": { "$ref": "#/components/schemas/MonitorStats" },
									"type": ["array", "null"]
								}
							}
						},
						"description": "OK"
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Get monitor stats",
				"tags": ["Monitors"]
			}
		},
		"/api/monitors/{id}/subscribe": {
			"post": {
				"operationId": "subscribe-to-monitor",
				"parameters": [
					{
						"description": "Monitor ID",
						"in": "path",
						"name": "id",
						"required": true,
						"schema": { "description": "Monitor ID", "format": "int64", "type": "integer" }
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/PushSubscriptionRequest" }
						}
					},
					"required": true
				},
				"responses": {
					"201": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/SubscribeOutputBody" }
							}
						},
						"description": "Created"
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Subscribe to push notifications for a monitor",
				"tags": ["Notifications"]
			}
		},
		"/api/monitors/{id}/unsubscribe": {
			"post": {
				"operationId": "unsubscribe-from-monitor",
				"parameters": [
					{
						"description": "Monitor ID",
						"in": "path",
						"name": "id",
						"required": true,
						"schema": { "description": "Monitor ID", "format": "int64", "type": "integer" }
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/UnsubscribeInputBody" }
						}
					},
					"required": true
				},
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/UnsubscribeOutputBody" }
							}
						},
						"description": "OK"
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Unsubscribe from push notifications for a monitor",
				"tags": ["Notifications"]
			}
		},
		"/api/vapid-public-key": {
			"get": {
				"operationId": "get-vapid-public-key",
				"responses": {
					"200": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/VAPIDOutputBody" } }
						},
						"description": "OK"
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Get VAPID public key",
				"tags": ["Notifications"]
			}
		}
	}
}
