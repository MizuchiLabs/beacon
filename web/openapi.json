{
	"components": {
		"schemas": {
			"ConfigBody": {
				"additionalProperties": false,
				"properties": {
					"logo_url": {
						"description": "URL of a custom logo image shown in the header",
						"type": "string"
					},
					"title": { "description": "Dashboard title", "type": "string" }
				},
				"required": ["title"],
				"type": "object"
			},
			"DataPoint": {
				"additionalProperties": false,
				"properties": {
					"avg_ms": {
						"description": "Mean response time of the up checks in the bucket",
						"format": "int64",
						"type": ["integer", "null"]
					},
					"degraded": { "format": "int64", "type": "integer" },
					"down": { "format": "int64", "type": "integer" },
					"expected": {
						"description": "Checks this bucket should hold, zero when it is shorter than the check interval. No data with a non zero expectation is a gap in monitoring",
						"format": "int64",
						"type": "integer"
					},
					"has_data": {
						"description": "Whether any check landed in this bucket",
						"type": "boolean"
					},
					"timestamp": { "format": "date-time", "type": "string" },
					"total": { "format": "int64", "type": "integer" },
					"up": { "format": "int64", "type": "integer" }
				},
				"required": [
					"timestamp",
					"has_data",
					"expected",
					"total",
					"up",
					"degraded",
					"down",
					"avg_ms"
				],
				"type": "object"
			},
			"ErrorDetail": {
				"additionalProperties": false,
				"properties": {
					"location": {
						"description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
						"type": "string"
					},
					"message": { "description": "Error message text", "type": "string" },
					"value": { "description": "The value at the given location" }
				},
				"type": "object"
			},
			"ErrorModel": {
				"additionalProperties": false,
				"properties": {
					"detail": {
						"description": "A human-readable explanation specific to this occurrence of the problem.",
						"examples": ["Property foo is required but is missing."],
						"type": "string"
					},
					"errors": {
						"description": "Optional list of individual error details",
						"items": { "$ref": "#/components/schemas/ErrorDetail" },
						"type": ["array", "null"]
					},
					"instance": {
						"description": "A URI reference that identifies the specific occurrence of the problem.",
						"examples": ["https://example.com/error-log/abc123"],
						"format": "uri",
						"type": "string"
					},
					"status": {
						"description": "HTTP status code",
						"examples": [400],
						"format": "int64",
						"type": "integer"
					},
					"title": {
						"description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
						"examples": ["Bad Request"],
						"type": "string"
					},
					"type": {
						"default": "about:blank",
						"description": "A URI reference to human-readable documentation for the error.",
						"examples": ["https://example.com/errors/example"],
						"format": "uri",
						"type": "string"
					}
				},
				"type": "object"
			},
			"HeartbeatOutputBody": {
				"additionalProperties": false,
				"properties": { "ok": { "type": "boolean" } },
				"required": ["ok"],
				"type": "object"
			},
			"Incident": {
				"additionalProperties": false,
				"properties": {
					"affected_monitors": {
						"description": "Monitor names, empty means every monitor",
						"items": { "type": "string" },
						"type": ["array", "null"]
					},
					"description": { "type": "string" },
					"ends_at": {
						"description": "Planned end of a maintenance window, it counts as resolved afterwards",
						"format": "date-time",
						"type": "string"
					},
					"id": { "type": "string" },
					"resolved_at": {
						"description": "Taken from the resolved update unless the file sets it",
						"format": "date-time",
						"type": "string"
					},
					"severity": { "enum": ["critical", "major", "minor", "maintenance"], "type": "string" },
					"started_at": { "format": "date-time", "type": "string" },
					"status": {
						"description": "Taken from the latest update unless the file sets it",
						"enum": ["scheduled", "investigating", "identified", "monitoring", "resolved"],
						"type": "string"
					},
					"title": { "type": "string" },
					"updates": {
						"description": "Oldest first",
						"items": { "$ref": "#/components/schemas/IncidentUpdate" },
						"type": ["array", "null"]
					}
				},
				"required": ["id", "title", "severity", "status", "started_at"],
				"type": "object"
			},
			"IncidentUpdate": {
				"additionalProperties": false,
				"properties": {
					"created_at": { "format": "date-time", "type": "string" },
					"message": { "type": "string" },
					"status": {
						"enum": ["scheduled", "investigating", "identified", "monitoring", "resolved"],
						"type": "string"
					}
				},
				"required": ["message", "status", "created_at"],
				"type": "object"
			},
			"MonitorStats": {
				"additionalProperties": false,
				"properties": {
					"avg_response_time": {
						"description": "Mean response time of the up checks in the window",
						"format": "int64",
						"type": ["integer", "null"]
					},
					"check_interval": { "format": "int64", "type": "integer" },
					"data_points": {
						"items": { "$ref": "#/components/schemas/DataPoint" },
						"type": ["array", "null"]
					},
					"days_remaining": {
						"description": "Days until the certificate expires, https and ssl monitors only",
						"format": "int64",
						"type": ["integer", "null"]
					},
					"degraded_threshold": {
						"description": "Response time in ms above which an up check counts as degraded",
						"format": "int64",
						"type": "integer"
					},
					"group": {
						"description": "Group the monitor is shown under, empty for none",
						"type": "string"
					},
					"id": { "format": "int64", "type": "integer" },
					"ignore_cert_expiry": {
						"description": "Whether certificate expiry is ignored for status and warnings",
						"type": "boolean"
					},
					"last_checked_at": {
						"description": "Timestamp of the latest check",
						"format": "date-time",
						"type": "string"
					},
					"name": { "type": "string" },
					"status": {
						"description": "Status of the latest check, unknown when the monitor has gone quiet",
						"enum": ["operational", "degraded", "down", "unknown"],
						"type": "string"
					},
					"type": {
						"description": "What kind of check this monitor runs",
						"enum": ["http", "tcp", "ssl", "dns", "ping", "push"],
						"type": "string"
					},
					"uptime_pct": { "format": "double", "type": ["number", "null"] },
					"url": {
						"description": "Monitor url, empty for push monitors so the token stays private",
						"type": "string"
					}
				},
				"required": [
					"id",
					"name",
					"url",
					"type",
					"group",
					"check_interval",
					"degraded_threshold",
					"status",
					"days_remaining",
					"ignore_cert_expiry",
					"avg_response_time",
					"uptime_pct",
					"data_points"
				],
				"type": "object"
			},
			"Percentiles": {
				"additionalProperties": false,
				"properties": {
					"p50": { "format": "int64", "type": "integer" },
					"p75": { "format": "int64", "type": "integer" },
					"p90": { "format": "int64", "type": "integer" },
					"p95": { "format": "int64", "type": "integer" },
					"p99": { "format": "int64", "type": "integer" }
				},
				"required": ["p50", "p75", "p90", "p95", "p99"],
				"type": "object"
			},
			"PercentilesOutputBody": {
				"additionalProperties": false,
				"properties": {
					"percentiles": {
						"$ref": "#/components/schemas/Percentiles",
						"description": "Null when the window holds no up checks"
					}
				},
				"required": ["percentiles"],
				"type": "object"
			},
			"PushSubscriptionKeys": {
				"additionalProperties": false,
				"properties": {
					"auth": { "description": "Authentication secret", "type": "string" },
					"p256dh": { "description": "Client public key", "type": "string" }
				},
				"required": ["p256dh", "auth"],
				"type": "object"
			},
			"PushSubscriptionRequest": {
				"additionalProperties": false,
				"properties": {
					"endpoint": {
						"description": "Push service endpoint URL",
						"format": "uri",
						"type": "string"
					},
					"keys": { "$ref": "#/components/schemas/PushSubscriptionKeys" }
				},
				"required": ["endpoint", "keys"],
				"type": "object"
			},
			"SubscribeOutputBody": {
				"additionalProperties": false,
				"properties": { "message": { "type": "string" } },
				"required": ["message"],
				"type": "object"
			},
			"SubscriptionsInputBody": {
				"additionalProperties": false,
				"properties": {
					"endpoint": {
						"description": "Push service endpoint URL of this browser",
						"format": "uri",
						"type": "string"
					}
				},
				"required": ["endpoint"],
				"type": "object"
			},
			"SubscriptionsOutputBody": {
				"additionalProperties": false,
				"properties": {
					"monitor_ids": {
						"description": "Monitors this endpoint is subscribed to",
						"items": { "format": "int64", "type": "integer" },
						"type": ["array", "null"]
					}
				},
				"required": ["monitor_ids"],
				"type": "object"
			},
			"SyncIncidentsOutputBody": {
				"additionalProperties": false,
				"properties": { "ok": { "type": "boolean" } },
				"required": ["ok"],
				"type": "object"
			},
			"UnsubscribeInputBody": {
				"additionalProperties": false,
				"properties": {
					"endpoint": {
						"description": "Push service endpoint URL to remove",
						"format": "uri",
						"type": "string"
					}
				},
				"required": ["endpoint"],
				"type": "object"
			},
			"UnsubscribeOutputBody": {
				"additionalProperties": false,
				"properties": { "message": { "type": "string" } },
				"required": ["message"],
				"type": "object"
			},
			"VAPIDOutputBody": {
				"additionalProperties": false,
				"properties": {
					"publicKey": {
						"description": "VAPID public key for push subscriptions",
						"type": "string"
					}
				},
				"required": ["publicKey"],
				"type": "object"
			}
		}
	},
	"info": { "title": "Beacon API", "version": "1.0.0" },
	"openapi": "3.1.0",
	"paths": {
		"/api/badge/{name}": {
			"get": {
				"description": "An SVG badge for READMEs and dashboards.",
				"operationId": "get-badge",
				"parameters": [
					{
						"description": "Monitor name",
						"in": "path",
						"name": "name",
						"required": true,
						"schema": { "description": "Monitor name", "type": "string" }
					},
					{
						"description": "Show the current status or the uptime over the window",
						"explode": false,
						"in": "query",
						"name": "kind",
						"schema": {
							"default": "status",
							"description": "Show the current status or the uptime over the window",
							"enum": ["status", "uptime"],
							"type": "string"
						}
					},
					{
						"description": "Uptime window in seconds",
						"explode": false,
						"in": "query",
						"name": "seconds",
						"schema": {
							"default": 2592000,
							"description": "Uptime window in seconds",
							"format": "int64",
							"maximum": 31536000,
							"minimum": 3600,
							"type": "integer"
						}
					}
				],
				"responses": {
					"200": {
						"content": { "image/svg+xml": {} },
						"description": "OK",
						"headers": {
							"Cache-Control": { "schema": { "type": "string" } },
							"Content-Type": { "schema": { "type": "string" } }
						}
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Get a status or uptime badge",
				"tags": ["Badges"]
			}
		},
		"/api/config": {
			"get": {
				"description": "Public configuration used by the dashboard frontend.",
				"operationId": "get-config",
				"responses": {
					"200": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/ConfigBody" } }
						},
						"description": "OK"
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Get dashboard config",
				"tags": ["Config"]
			}
		},
		"/api/incidents": {
			"get": {
				"operationId": "get-incidents",
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"items": { "$ref": "#/components/schemas/Incident" },
									"type": ["array", "null"]
								}
							}
						},
						"description": "OK"
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "List incidents",
				"tags": ["Incidents"]
			}
		},
		"/api/incidents/sync": {
			"post": {
				"description": "Point a git push webhook here so updates show up without waiting for the sync interval. Needs BEACON_INCIDENT_SYNC_TOKEN as the webhook secret.",
				"operationId": "sync-incidents",
				"parameters": [
					{
						"description": "Bearer \u003ctoken\u003e, e.g. Gitea, Forgejo or curl",
						"in": "header",
						"name": "Authorization",
						"schema": {
							"description": "Bearer \u003ctoken\u003e, e.g. Gitea, Forgejo or curl",
							"type": "string"
						}
					},
					{
						"description": "GitLab webhook secret token",
						"in": "header",
						"name": "X-Gitlab-Token",
						"schema": { "description": "GitLab webhook secret token", "type": "string" }
					},
					{
						"description": "GitHub webhook signature, the secret is the token",
						"in": "header",
						"name": "X-Hub-Signature-256",
						"schema": {
							"description": "GitHub webhook signature, the secret is the token",
							"type": "string"
						}
					}
				],
				"requestBody": {
					"content": {
						"application/octet-stream": {
							"schema": {
								"contentMediaType": "application/octet-stream",
								"format": "binary",
								"type": "string"
							}
						}
					}
				},
				"responses": {
					"202": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/SyncIncidentsOutputBody" }
							}
						},
						"description": "Accepted"
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Reload incidents now",
				"tags": ["Incidents"]
			}
		},
		"/api/incidents/{id}": {
			"get": {
				"operationId": "get-incident",
				"parameters": [
					{
						"description": "Incident ID",
						"in": "path",
						"name": "id",
						"required": true,
						"schema": { "description": "Incident ID", "type": "string" }
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": { "schema": { "$ref": "#/components/schemas/Incident" } }
						},
						"description": "OK"
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Get an incident",
				"tags": ["Incidents"]
			}
		},
		"/api/monitors": {
			"get": {
				"description": "Aggregated uptime and response time stats per monitor over the requested window.",
				"operationId": "get-monitors",
				"parameters": [
					{
						"description": "How far back to aggregate, in seconds",
						"explode": false,
						"in": "query",
						"name": "seconds",
						"schema": {
							"default": 86400,
							"description": "How far back to aggregate, in seconds",
							"format": "int64",
							"maximum": 31536000,
							"minimum": 60,
							"type": "integer"
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": {
									"items": { "$ref": "#/components/schemas/MonitorStats" },
									"type": ["array", "null"]
								}
							}
						},
						"description": "OK"
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Get monitor stats",
				"tags": ["Monitors"]
			}
		},
		"/api/monitors/{id}/percentiles": {
			"get": {
				"description": "Percentiles of the raw checks in the window, null without checks. Raw checks only go back as far as BEACON_RETENTION_DAYS.",
				"operationId": "get-monitor-percentiles",
				"parameters": [
					{
						"description": "How far back to aggregate, in seconds",
						"explode": false,
						"in": "query",
						"name": "seconds",
						"schema": {
							"default": 86400,
							"description": "How far back to aggregate, in seconds",
							"format": "int64",
							"maximum": 31536000,
							"minimum": 60,
							"type": "integer"
						}
					},
					{
						"description": "Monitor ID",
						"in": "path",
						"name": "id",
						"required": true,
						"schema": { "description": "Monitor ID", "format": "int64", "type": "integer" }
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/PercentilesOutputBody" }
							}
						},
						"description": "OK"
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Get response time percentiles",
				"tags": ["Monitors"]
			}
		},
		"/api/monitors/{id}/subscribe": {
			"post": {
				"operationId": "subscribe-to-monitor",
				"parameters": [
					{
						"description": "Monitor ID",
						"in": "path",
						"name": "id",
						"required": true,
						"schema": { "description": "Monitor ID", "format": "int64", "type": "integer" }
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/PushSubscriptionRequest" }
						}
					},
					"required": true
				},
				"responses": {
					"201": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/SubscribeOutputBody" }
							}
						},
						"description": "Created"
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Subscribe to push notifications for a monitor",
				"tags": ["Notifications"]
			}
		},
		"/api/monitors/{id}/unsubscribe": {
			"post": {
				"operationId": "unsubscribe-from-monitor",
				"parameters": [
					{
						"description": "Monitor ID",
						"in": "path",
						"name": "id",
						"required": true,
						"schema": { "description": "Monitor ID", "format": "int64", "type": "integer" }
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": { "$ref": "#/components/schemas/UnsubscribeInputBody" }
						}
					},
					"required": true
				},
				"responses": {
					"200": {
						"content": {
							"application/json": {
								"schema": { "$ref": "#/components/schemas/UnsubscribeOutputBody" }
							}
						},
						"description": "OK"
					},
					"default": {
						"content": {
							"application/problem+json": {
								"schema": { "$ref": "#/components/schemas/ErrorModel" }
							}
						},
						"description": "Error"
					}
				},
				"summary": "Unsubscribe from push notifications for a monitor",
				"tags": ["Notifications"]
			}
		},
		"/api/push/{token}": {
			"get": {
				"operationId": "heartbeat-get",
				"parameters": [
					{
						"description": "Token from the push://\u003ctoken\u003e url of the monitor",
						"in": "path",
						"name": "token",
						"required": true,
						"schema": {
							"description": "Token from the push://\u003ctoken\u003e url of the monitor",
							"type": "string"
						}
					},
					{
						"description": "Report a failure with down",
						"explode": false,
						"in": "query",
						"name": "status",
						"schema": {
							"default": "up",
							"description": "Report a failure with down",
							"enum": ["up", "down"],
							"type": "string"
						}
					},
					{
						"description": "Why the job failed, sent with the notification",
						"explode": false,
						"in": "query",
						"name": "msg",
						"schema": {
							"description": "Why the job failed, sent with the notification",
							"maxLength": 500,
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"content": {
							"application/json": {
