{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://raw.githubusercontent.com/mizuchilabs/beacon/main/incident.schema.json",
	"title": "Beacon incident",
	"type": "object",
	"required": ["title", "severity", "started_at"],
	"additionalProperties": false,
	"$defs": {
		"status": {
			"type": "string",
			"enum": ["scheduled", "investigating", "identified", "monitoring", "resolved"]
		},
		"time": {
			"type": "string",
			"format": "date-time",
			"description": "RFC 3339, e.g. 2025-01-15T14:30:00Z"
		}
	},
	"properties": {
		"id": {
			"type": "string",
			"description": "Defaults to the file name without extension"
		},
		"title": { "type": "string" },
		"description": { "type": "string" },
		"severity": {
			"type": "string",
			"enum": ["critical", "major", "minor", "maintenance"]
		},
		"status": {
			"$ref": "#/$defs/status",
			"description": "Optional, taken from the latest update"
		},
		"affected_monitors": {
			"type": "array",
			"items": { "type": "string" },
			"description": "Monitor names from the config, leave out for all monitors"
		},
		"started_at": { "$ref": "#/$defs/time" },
		"ends_at": {
			"$ref": "#/$defs/time",
			"description": "Planned end of a maintenance window, the incident resolves itself afterwards"
		},
		"resolved_at": {
			"$ref": "#/$defs/time",
			"description": "Optional, taken from the resolved update"
		},
		"updates": {
			"type": "array",
			"items": {
				"type": "object",
				"required": ["message", "status", "created_at"],
				"additionalProperties": false,
				"properties": {
					"message": { "type": "string" },
					"status": { "$ref": "#/$defs/status" },
					"created_at": { "$ref": "#/$defs/time" }
				}
			}
		}
	}
}
